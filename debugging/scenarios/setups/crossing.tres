[gd_resource type="Resource" script_class="TrafficSetup" format=3]

[ext_resource type="Script" path="res://debugging/scenarios/traffic_setup.gd" id="1_setup"]

[resource]
script = ExtResource("1_setup")
description = "F7 crossing: middle (0, 0) -> (0, -120), left (-30, 0) -> (30, -120), right (30, 0) -> (-30, -120), all near (0, -60) at once. Expect passage middle, left, right, then arrival without contact."
positions = PackedVector3Array(0, 0, 0, -30, 0, 0, 30, 0, 0)
yaws = PackedFloat32Array(0, 0, 0)
velocities = PackedVector3Array(0, 0, 0, 0, 0, 0, 0, 0, 0)
order_times = PackedFloat32Array(0, 0, 0)
order_slots = PackedInt32Array(0, 1, 2)
order_points = PackedVector3Array(0, 0, -120, 30, 0, -120, -30, 0, -120)
camera_focus = Vector3(0, 0, -60)
camera_height = 140
